# Copy to .env.local and fill in. Only PUBLIC values belong in VITE_* variables —
# they are bundled into the browser. Never put the Supabase secret/service-role key here.

# Supabase project URL and publishable (anon) key — both are safe to expose.
VITE_SUPABASE_URL=https://hqqnfmrzqsiehyunfibn.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile site key (bot check on sign-in forms; public). The matching secret
# key goes only in Supabase → Authentication → Attack Protection, never here.
VITE_TURNSTILE_SITE_KEY=
